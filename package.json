{
  "name": "efh-crm-system",
  "version": "1.0.0",
  "description": "CRM for a mortgage broking business: leads, deal pipeline, tasks, commissions and workflow automation.",
  "private": true,
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "seed": "node --disable-warning=ExperimentalWarning src/db/seed.js",
    "test": "node --disable-warning=ExperimentalWarning --test --test-timeout=60000 \"test/**/*.test.js\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "docx": "^9.10.0",
    "express": "^5.1.0",
    "nodemailer": "^10.1.0",
    "pdfmake": "^0.3.11",
    "read-excel-file": "^9.3.12",
    "sanitize-html": "^2.18.0"
  },
  "devDependencies": {
    "write-excel-file": "^4.1.1"
  }
}
