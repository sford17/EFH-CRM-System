# Copy to .env (or set in your hosting environment). All optional.
PORT=3000
HOST=127.0.0.1                  # use 0.0.0.0 to accept connections from other machines
DB_FILE=./data/crm.db
TZ_BUSINESS=Australia/Sydney    # time zone used for "today" in automations
SCHEDULER_INTERVAL_MS=300000    # how often scheduled automations & the outbox run
COOKIE_SECURE=false             # set true when served over HTTPS
TRUST_PROXY=false               # set true behind a reverse proxy

ENCRYPTION_KEY=                 # optional; otherwise a key is generated in data/secret.key
MAIL_SYNC_DAYS=30               # how far back the first Outlook sync looks

# SMS is configured in the app (Settings → SMS). CLICKSEND_API_URL can point at a test server.

# Fallback outgoing email for users without Outlook connected.
# Without SMTP_HOST, emails are recorded as "logged" but not sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="EFH Mortgage Broking <hello@example.com>"
